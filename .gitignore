# Waypoint University owner secrets (never commit)
private/university/server/.env
private/university/server/.owner-secret


# Deploy-time build metadata is injected into the Pages artifact from GITHUB_SHA.
# Keep a committed stub for local browsing; ignore accidental local regenerations
# when developers run inject/generate against HEAD.
data/build-info.json.generated
design-system/js/wds-build.js.generated

# Live-engine publish artifacts (regenerated by publish scripts; do not commit churn)
# Keep tracked baseline copies if already in git — ignore only local overrides when untracked.
data/live.json.local
data/health.json.local
data/publish-state.json.local
*.local.json

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

