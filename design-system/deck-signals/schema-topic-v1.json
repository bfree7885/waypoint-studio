{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypoint.studio/schemas/signalterrain/topic/v1",
  "title": "SignalTerrain Topic v1",
  "description": "Durable SignalTerrain topic — evolves over time. Educational / awareness platform entity. Not a SOC ticket, exploit record, or news card.",
  "type": "object",
  "required": [
    "meta",
    "id",
    "workspace",
    "kind",
    "title",
    "summary",
    "overview",
    "confidence",
    "unknowns",
    "verification",
    "waypointAnalysis"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "schema", "status"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "const": "1.0.0" },
        "schema": {
          "type": "string",
          "const": "https://waypoint.studio/schemas/signalterrain/topic/v1"
        },
        "status": {
          "type": "string",
          "enum": ["sample", "draft", "active", "archived"]
        },
        "createdAt": { "type": ["string", "null"], "format": "date-time" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" },
        "aiAssisted": { "type": "boolean" },
        "disclaimer": { "type": "string", "maxLength": 1024 }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^st_[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "workspace": {
      "type": "string",
      "enum": ["rf", "cyber", "infrastructure", "research"]
    },
    "kind": {
      "type": "string",
      "enum": [
        "vulnerability",
        "threat-actor",
        "malware-family",
        "advisory",
        "frequency",
        "propagation",
        "satellite",
        "protocol",
        "agency",
        "research-paper",
        "standard",
        "rfc",
        "provider",
        "infrastructure",
        "campaign",
        "organization",
        "company",
        "vendor",
        "country",
        "technology",
        "software",
        "product",
        "cloud-provider",
        "internet-event",
        "communications-event",
        "power-event",
        "weather-event",
        "space-weather-event",
        "conference-presentation",
        "mitigation",
        "historical-incident",
        "future-development",
        "person",
        "signal-system",
        "other"
      ]
    },
    "title": { "type": "string", "maxLength": 200 },
    "summary": { "type": "string", "maxLength": 400 },
    "overview": { "type": "string", "maxLength": 4000 },
    "historicalContext": { "type": ["string", "null"], "maxLength": 4000 },
    "technicalExplanation": { "type": ["string", "null"], "maxLength": 4000 },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "text"],
        "additionalProperties": false,
        "properties": {
          "at": { "type": "string" },
          "text": { "type": "string", "maxLength": 600 },
          "kind": {
            "type": "string",
            "enum": [
              "discovery",
              "disclosure",
              "patch",
              "advisory",
              "research",
              "incident",
              "mitigation",
              "historical",
              "development",
              "other"
            ]
          },
          "sourceLabel": { "type": ["string", "null"] }
        }
      }
    },
    "primarySources": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "governmentRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "research": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "technicalDocs": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "knownFacts": {
      "type": "array",
      "items": { "type": "string", "maxLength": 400 }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "maxLength": 400 }
    },
    "watchFor": {
      "type": "array",
      "items": { "type": "string", "maxLength": 400 }
    },
    "questionsWorthInvestigating": {
      "type": "array",
      "items": { "type": "string", "maxLength": 400 }
    },
    "confidence": {
      "type": "object",
      "required": ["level", "rationale"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["high", "moderate", "low", "speculative", "insufficient"]
        },
        "trustLabel": {
          "type": "string",
          "enum": ["very-high", "high", "moderate", "limited", "preliminary", "unknown"]
        },
        "rationale": { "type": "string", "maxLength": 800 }
      }
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified-primary",
            "corroborated",
            "single-source",
            "unverified",
            "disputed",
            "educational-sample"
          ]
        },
        "lastVerifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "limitations": { "type": ["string", "null"], "maxLength": 800 }
      }
    },
    "waypointAnalysis": {
      "type": "object",
      "required": ["text", "editorialStatus"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "maxLength": 2000 },
        "editorialStatus": {
          "type": "string",
          "enum": ["draft", "reviewed", "sample", "not-applicable"]
        },
        "authorLabel": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 64 }
    },
    "relatedKnowledgeIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "signalCardIds": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 256 },
        "url": { "type": ["string", "null"], "format": "uri" },
        "kind": {
          "type": "string",
          "enum": [
            "primary",
            "government",
            "vendor",
            "research",
            "technical",
            "status-page",
            "other"
          ]
        },
        "accessedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
