{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypoint.studio/schemas/signalterrain/recommendation/v0.1",
  "title": "SignalTerrain Defensive Recommendation v0.1",
  "description": "Human-reviewed defensive guidance. Never auto-executes. No offensive content.",
  "type": "object",
  "required": [
    "meta",
    "id",
    "title",
    "why",
    "who",
    "priority",
    "evidence",
    "action",
    "expectedDuration",
    "confidence",
    "unknowns"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "schema", "status"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "const": "0.1.0" },
        "schema": {
          "type": "string",
          "const": "https://waypoint.studio/schemas/signalterrain/recommendation/v0.1"
        },
        "status": {
          "type": "string",
          "enum": ["sample", "draft", "suggested", "accepted", "deferred", "dismissed", "expired"]
        },
        "disclaimer": { "type": "string", "maxLength": 1024 }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^rec_[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "maxLength": 200 },
    "why": { "type": "string", "maxLength": 1200 },
    "who": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "maxLength": 200 }
    },
    "priority": {
      "type": "string",
      "enum": ["low", "moderate", "high", "urgent"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "maxLength": 600 },
          "url": { "type": ["string", "null"], "format": "uri" }
        }
      }
    },
    "action": {
      "type": "string",
      "maxLength": 1200,
      "description": "Plain-language defensive action. Never exploit steps."
    },
    "expectedDuration": { "type": "string", "maxLength": 200 },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "maxLength": 400 }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "moderate", "low", "speculative", "insufficient"]
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "maxLength": 400 }
    },
    "relatedUioIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^uio_" }
    },
    "relatedTopicIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^st_" }
    },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "autoExecute": {
      "type": "boolean",
      "const": false,
      "description": "Must always be false in V0.1."
    }
  }
}
