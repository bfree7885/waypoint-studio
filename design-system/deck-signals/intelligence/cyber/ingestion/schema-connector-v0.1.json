{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypoint.studio/schemas/signalterrain/cyber/connector/v0.1",
  "title": "Cyber Ingestion Connector Interface v0.1",
  "description": "Common interface for independently replaceable intelligence providers. Extends Intelligence Core provider concepts with operational metadata. Connectors must not know about each other.",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "version",
    "status",
    "reliability",
    "refreshInterval",
    "supportedDataTypes",
    "rateLimits",
    "attribution",
    "honesty",
    "normalizeContract"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^conn_[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "providerId": {
      "type": ["string", "null"],
      "pattern": "^prov_[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Optional link to Intelligence Core providers.json"
    },
    "name": { "type": "string", "maxLength": 200 },
    "category": {
      "type": "string",
      "enum": [
        "security-advisory",
        "vendor-advisory",
        "vulnerability-database",
        "government-advisory",
        "security-news",
        "ransomware-tracking",
        "patch-bulletin",
        "threat-intel-blog",
        "academic-publication"
      ]
    },
    "version": { "type": "string", "maxLength": 32 },
    "status": {
      "type": "string",
      "enum": ["designed", "mock", "stub", "preview", "active", "retired"]
    },
    "reliability": {
      "type": "string",
      "enum": ["very-high", "high", "moderate", "limited", "experimental"]
    },
    "refreshInterval": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "enum": ["minutes", "hours", "days", "manual"] }
      }
    },
    "lastSuccessfulUpdate": { "type": ["string", "null"], "format": "date-time" },
    "lastFailure": { "type": ["string", "null"], "format": "date-time" },
    "supportedDataTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "advisory",
          "vulnerability",
          "cve",
          "kev",
          "patch",
          "threat-update",
          "research-item",
          "ransomware-report",
          "news-item"
        ]
      }
    },
    "rateLimits": {
      "type": "object",
      "required": ["requestsPerHour", "notes"],
      "additionalProperties": false,
      "properties": {
        "requestsPerHour": { "type": ["number", "null"] },
        "notes": { "type": "string", "maxLength": 400 }
      }
    },
    "attribution": {
      "type": "object",
      "required": ["label", "licenseHint"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 200 },
        "url": { "type": ["string", "null"], "maxLength": 2048 },
        "licenseHint": { "type": "string", "maxLength": 400 }
      }
    },
    "honesty": {
      "type": "object",
      "required": ["neverFabricate", "labelSamples", "noExploitPayloads"],
      "additionalProperties": false,
      "properties": {
        "neverFabricate": { "type": "boolean", "const": true },
        "labelSamples": { "type": "boolean", "const": true },
        "noExploitPayloads": { "type": "boolean", "const": true },
        "notes": { "type": "string", "maxLength": 800 }
      }
    },
    "normalizeContract": {
      "type": "object",
      "required": ["input", "output"],
      "additionalProperties": false,
      "properties": {
        "input": { "type": "string" },
        "output": {
          "type": "string",
          "const": "normalized-record[]"
        },
        "mapsToSchemas": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "cachePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttlHours": { "type": "number", "minimum": 0 },
        "offlineUseful": { "type": "boolean" }
      }
    },
    "docs": { "type": "string", "maxLength": 400 }
  }
}
