{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypoint.studio/schemas/signalterrain/cyber/priority-score/v0.1",
  "title": "Cyber Awareness Priority Score v0.1",
  "description": "Transparent priority result. Every point must be explained. No mysterious AI scores.",
  "type": "object",
  "required": [
    "meta",
    "id",
    "subjectId",
    "total",
    "band",
    "contributions",
    "summaryWhy",
    "computedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "schema", "status", "engineVersion"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "const": "0.1.0" },
        "schema": {
          "type": "string",
          "const": "https://waypoint.studio/schemas/signalterrain/cyber/priority-score/v0.1"
        },
        "status": { "type": "string", "enum": ["sample", "draft", "active"] },
        "engineVersion": { "type": "string" },
        "disclaimer": { "type": "string" }
      }
    },
    "id": { "type": "string", "pattern": "^cyp_[a-z0-9-]+$" },
    "subjectId": { "type": "string" },
    "total": { "type": "number", "minimum": 0, "maximum": 100 },
    "band": {
      "type": "string",
      "enum": ["low", "moderate", "high", "urgent"]
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["factorId", "points", "reason"],
        "additionalProperties": false,
        "properties": {
          "factorId": { "type": "string" },
          "points": { "type": "number" },
          "maxPoints": { "type": "number" },
          "inputValue": {},
          "reason": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "summaryWhy": { "type": "string", "maxLength": 1000 },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "maxLength": 400 }
    },
    "computedAt": { "type": "string", "format": "date-time" }
  }
}
