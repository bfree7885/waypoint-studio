{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypoint.studio/schemas/volunteer/opportunity/v0.1",
  "title": "Waypoint Volunteer Opportunity v0.1",
  "description": "Discoverable volunteer opportunity. Not a registration ticket or management record.",
  "type": "object",
  "required": [
    "meta",
    "id",
    "title",
    "description",
    "organizationId",
    "location",
    "setting",
    "schedule",
    "estimatedDuration",
    "physicalEffort",
    "categories",
    "requiredSkills"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "schema", "status"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "const": "0.1.0" },
        "schema": {
          "type": "string",
          "const": "https://waypoint.studio/schemas/volunteer/opportunity/v0.1"
        },
        "status": {
          "type": "string",
          "enum": ["sample", "draft", "active", "archived"]
        },
        "disclaimer": { "type": "string", "maxLength": 1024 }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^vo_[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "organizationId": {
      "type": "string",
      "pattern": "^org_"
    },
    "location": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 256 },
        "regionHint": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"], "maxLength": 400 }
      }
    },
    "setting": {
      "type": "string",
      "enum": ["indoor", "outdoor", "mixed"]
    },
    "schedule": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["one-time", "recurring"]
        },
        "whenLabel": { "type": ["string", "null"], "maxLength": 200 },
        "recurrenceNote": { "type": ["string", "null"], "maxLength": 400 }
      }
    },
    "estimatedDuration": {
      "type": "object",
      "required": ["minutes", "label"],
      "additionalProperties": false,
      "properties": {
        "minutes": { "type": "integer", "minimum": 15, "maximum": 1440 },
        "label": { "type": "string", "maxLength": 64 }
      }
    },
    "physicalEffort": {
      "type": "string",
      "enum": ["light", "moderate", "strenuous"]
    },
    "accessibility": {
      "type": ["string", "null"],
      "maxLength": 800,
      "description": "Honest accessibility notes — never invent compliance claims."
    },
    "weatherSensitive": { "type": "boolean" },
    "seasonal": {
      "type": ["string", "null"],
      "maxLength": 200
    },
    "ageRequirements": {
      "type": ["string", "null"],
      "maxLength": 400
    },
    "familyFriendly": { "type": "boolean" },
    "requiredSkills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Skill ids from skills.json — may be empty when no special skills required."
    },
    "suggestedClothing": {
      "type": "array",
      "items": { "type": "string", "maxLength": 120 }
    },
    "suggestedEquipment": {
      "type": "array",
      "items": { "type": "string", "maxLength": 120 }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "todayOutsideHints": {
      "type": "array",
      "items": { "type": "string", "maxLength": 200 },
      "description": "Optional calm glance lines for Dashboard / Today Outside."
    },
    "bridgeApps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["fieldry", "scenes", "foragecast", "signalterrain", "dashboard", "photo-coach"]
      },
      "description": "Suggested Waypoint apps for related learning — not deep integrations yet."
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "maxLength": 400 }
    }
  }
}
