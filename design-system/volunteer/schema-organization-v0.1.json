{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypoint.studio/schemas/volunteer/organization/v0.1",
  "title": "Waypoint Volunteer Organization v0.1",
  "description": "Community organization offering volunteer opportunities. Discovery only — not a CRM or volunteer management system.",
  "type": "object",
  "required": ["meta", "id", "name", "description", "mission", "categories", "serviceArea"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "schema", "status"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "const": "0.1.0" },
        "schema": {
          "type": "string",
          "const": "https://waypoint.studio/schemas/volunteer/organization/v0.1"
        },
        "status": {
          "type": "string",
          "enum": ["sample", "draft", "active", "archived"]
        },
        "disclaimer": { "type": "string", "maxLength": 1024 }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^org_[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "website": { "type": ["string", "null"], "format": "uri" },
    "mission": { "type": "string", "maxLength": 1200 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "serviceArea": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 256 },
        "regionHint": { "type": ["string", "null"] },
        "precision": {
          "type": "string",
          "enum": ["region", "county", "city", "site"],
          "description": "Prefer coarse labels; exact addresses optional and careful."
        }
      }
    }
  }
}
