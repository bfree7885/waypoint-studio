{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypoint.studio/schemas/signal-intelligence/observation/v0.1",
  "title": "Waypoint Signal Intelligence — Observation v0.1",
  "description": "Reusable educational observation of an invisible environment (RF, cyber, or infrastructure). Not a SOC alert, exploit, or monitoring feed. Runtime collectors are not shipped in v0.1 — this schema defines the contract.",
  "type": "object",
  "required": [
    "meta",
    "id",
    "domain",
    "category",
    "summary",
    "explanation",
    "severity",
    "attention",
    "confidence",
    "threatContext",
    "evidence",
    "unknowns"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "schema", "engineVersion", "status"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "const": "0.1.0" },
        "schema": {
          "type": "string",
          "const": "https://waypoint.studio/schemas/signal-intelligence/observation/v0.1"
        },
        "engineVersion": {
          "type": "string",
          "pattern": "^0\\.1\\.\\d+$"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "sample", "recorded", "archived"],
          "description": "sample = documentation examples; recorded = future evaluator/collector output."
        },
        "createdAt": { "type": ["string", "null"], "format": "date-time" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" },
        "aiAssisted": {
          "type": "boolean",
          "description": "True if generative text contributed. Default false."
        },
        "disclaimer": {
          "type": "string",
          "maxLength": 1024,
          "description": "Short honesty line for consumers."
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^sio_[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable Signal Intelligence Observation id."
    },
    "domain": {
      "type": "string",
      "enum": ["rf-intelligence", "cyber-intelligence", "infrastructure-intelligence"]
    },
    "category": {
      "type": "string",
      "description": "Taxonomy category id (e.g. rf.noaa-weather-radio, cyber.cve)."
    },
    "taxonomyId": {
      "type": ["string", "null"],
      "description": "Optional precise term id from taxonomy.json."
    },
    "source": {
      "type": "object",
      "required": ["kind", "label"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-receiver-log",
            "user-note",
            "official-advisory",
            "vendor-advisory",
            "public-outage-status",
            "educational-curation",
            "educational-example",
            "community-opt-in",
            "space-weather-bulletin",
            "broadcast-schedule",
            "unknown"
          ]
        },
        "label": { "type": "string", "maxLength": 256 },
        "url": { "type": ["string", "null"], "format": "uri" },
        "accessedAt": { "type": ["string", "null"], "format": "date-time" },
        "reliability": {
          "type": "string",
          "enum": ["high", "moderate", "low", "unknown"],
          "description": "Publisher reliability, distinct from claim confidence."
        }
      }
    },
    "timestamp": {
      "type": "object",
      "required": ["observedAt"],
      "additionalProperties": false,
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "reportedAt": { "type": ["string", "null"], "format": "date-time" },
        "windowStart": { "type": ["string", "null"], "format": "date-time" },
        "windowEnd": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Optional. Prefer coarse precision; never dox private receivers by default.",
      "properties": {
        "label": { "type": ["string", "null"], "maxLength": 256 },
        "regionHint": { "type": ["string", "null"] },
        "precision": {
          "type": "string",
          "enum": ["none", "region", "grid", "coordinates-coarse", "coordinates-precise"],
          "description": "coordinates-precise requires explicit user consent in future products."
        },
        "notes": { "type": ["string", "null"], "maxLength": 512 }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["info", "notice", "elevated", "high", "critical"],
      "description": "Educational urgency of attention — not a CVSS clone and not an exploit priority. Prefer info/notice/elevated for most cyber digests."
    },
    "attention": {
      "type": "object",
      "required": ["level", "focus"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["background", "glance", "learn", "act-calmly", "monitor"],
          "description": "Recommended attention. act-calmly means educational actions (patch, backup check) — never offensive operations."
        },
        "focus": {
          "type": "string",
          "maxLength": 256,
          "description": "What to pay attention to in plain language."
        },
        "whyItMatters": {
          "type": "string",
          "maxLength": 800
        },
        "whatChanged": {
          "type": ["string", "null"],
          "maxLength": 800
        },
        "calmGuidance": {
          "type": ["string", "null"],
          "maxLength": 800,
          "description": "Anxiety-reducing next step; required tone for elevated+."
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 400,
      "description": "What is happening — one calm sentence."
    },
    "explanation": {
      "type": "string",
      "maxLength": 2400,
      "description": "Why it matters / how to think about it — educational."
    },
    "confidence": { "$ref": "#/$defs/confidenceBlock" },
    "threatContext": {
      "type": "object",
      "required": ["phase"],
      "additionalProperties": false,
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "current-conditions",
            "emerging-conditions",
            "resolved-events",
            "historical-patterns",
            "seasonal-trends"
          ]
        },
        "patternNote": { "type": ["string", "null"], "maxLength": 600 },
        "seasonHint": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "maxLength": 600 },
          "quality": {
            "type": "string",
            "enum": ["primary", "corroborating", "secondary", "anecdotal", "unknown"]
          },
          "url": { "type": ["string", "null"], "format": "uri" }
        }
      }
    },
    "relatedObservationIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "historicalComparison": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "maxLength": 800 },
        "baselinePeriod": { "type": ["string", "null"], "maxLength": 128 },
        "direction": {
          "type": "string",
          "enum": ["higher", "lower", "similar", "unknown", "not-applicable"]
        }
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "maxLength": 400 },
      "description": "Honest gaps — required so uncertainty stays visible."
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "maxLength": 600 },
          "sourceLabel": { "type": ["string", "null"] }
        }
      }
    },
    "attentionHints": {
      "type": "array",
      "description": "Optional adaptive-attention keys this observation may raise (see attention.json).",
      "items": { "type": "string" }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["signalterrain", "studio", "scenes", "outdoor-intelligence", "landscape-interpretation", "education", "shared"]
      }
    },
    "legalEthicsNotes": {
      "type": ["string", "null"],
      "maxLength": 800,
      "description": "Listening legality, privacy, or non-exploit reminders."
    }
  },
  "$defs": {
    "confidenceBlock": {
      "type": "object",
      "required": ["level", "evidenceQuality", "freshness", "sourceReliability", "rationale"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["high", "moderate", "low", "speculative", "insufficient"]
        },
        "evidenceQuality": {
          "type": "string",
          "enum": ["strong", "adequate", "thin", "rumor", "unknown"]
        },
        "freshness": {
          "type": "string",
          "enum": ["live-window", "hours", "days", "stale", "unknown"]
        },
        "sourceReliability": {
          "type": "string",
          "enum": ["high", "moderate", "low", "unknown"]
        },
        "rationale": { "type": "string", "maxLength": 800 },
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Optional internal. Prefer level labels in UI."
        }
      }
    }
  }
}
