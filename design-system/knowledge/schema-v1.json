{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypoint.studio/schemas/knowledge/v1",
  "title": "Waypoint Knowledge Platform — Entry",
  "description": "Canonical reusable knowledge entry for all Waypoint Studio applications. Domain packs extend via extensions[<domain>] without changing this core model. Species detail may delegate to WSKB via wskbId.",
  "type": "object",
  "required": ["meta", "id", "kind", "domains", "names", "description"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "schema", "updatedAt", "status"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "const": "1.0.0" },
        "schema": { "type": "string", "const": "https://waypoint.studio/schemas/knowledge/v1" },
        "createdAt": { "type": ["string", "null"], "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["draft", "published", "archived", "sample"] },
        "provenance": {
          "type": "string",
          "enum": ["verified", "educational", "regional", "sample", "unknown"],
          "description": "Honesty label for the record body."
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^kn_[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable knowledge id. Format: kn_ + slug."
    },
    "kind": {
      "type": "string",
      "enum": [
        "species",
        "taxon-group",
        "habitat",
        "concept",
        "material",
        "technique",
        "region",
        "equipment",
        "regulation",
        "phenomenon",
        "cultivar",
        "service",
        "organization"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "fieldry",
          "foragecast",
          "sheds",
          "steepleaf",
          "savant-sommelier",
          "signalterrain",
          "outdoor-intelligence",
          "scenes",
          "shared"
        ]
      }
    },
    "categories": {
      "type": "array",
      "items": { "type": "string" },
      "description": "App-facing categories (plants, birds, tea-varieties, frequency-bands, …)."
    },
    "names": {
      "type": "object",
      "required": ["common"],
      "additionalProperties": false,
      "properties": {
        "common": { "type": "string", "maxLength": 256 },
        "scientific": { "type": ["string", "null"], "maxLength": 256 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "synonyms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "description": { "type": "string", "maxLength": 4000 },
    "taxonomy": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kingdom": { "type": ["string", "null"] },
        "phylum": { "type": ["string", "null"] },
        "class": { "type": ["string", "null"] },
        "order": { "type": ["string", "null"] },
        "family": { "type": ["string", "null"] },
        "genus": { "type": ["string", "null"] },
        "species": { "type": ["string", "null"] },
        "rank": { "type": ["string", "null"] }
      }
    },
    "geography": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "distribution": { "type": ["string", "null"] },
        "regions": { "type": "array", "items": { "type": "string" } },
        "countries": { "type": "array", "items": { "type": "string" } },
        "bbox": {
          "type": ["object", "null"],
          "properties": {
            "west": { "type": "number" },
            "south": { "type": "number" },
            "east": { "type": "number" },
            "north": { "type": "number" }
          }
        }
      }
    },
    "seasonal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "months": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "phenologyNotes": { "type": ["string", "null"] },
        "triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "media": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": { "type": ["string", "null"] },
              "alt": { "type": "string" },
              "credit": { "type": ["string", "null"] },
              "placeholder": { "type": "boolean" }
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "url": { "type": ["string", "null"] },
          "publisher": { "type": ["string", "null"] }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "source": { "type": ["string", "null"] }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "search": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "keywords": { "type": "array", "items": { "type": "string" } },
        "boost": { "type": "number", "minimum": 0 }
      }
    },
    "related": {
      "type": "array",
      "description": "Inline related ids; authoritative graph may also live in relationships.json",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "label": { "type": ["string", "null"] }
        }
      }
    },
    "wskbId": {
      "type": ["string", "null"],
      "description": "When set, species detail delegates to WSKB — do not duplicate the full species body here."
    },
    "extensions": {
      "type": "object",
      "description": "Domain-specific payloads keyed by domain id.",
      "additionalProperties": true
    }
  }
}
