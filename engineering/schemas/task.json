{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypointstudio.org/engineering/schemas/task.json",
  "title": "Waypoint Engineering Task",
  "type": "object",
  "required": ["id", "title", "priority", "status", "acceptanceCriteria"],
  "properties": {
    "id": { "type": "string", "pattern": "^WE-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 3 },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "estimate": { "type": ["string", "null"] },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assignedAgent": { "type": ["string", "null"] },
    "status": {
      "enum": ["backlog", "ready", "in_progress", "blocked", "review", "done", "cancelled"]
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "area": { "type": "string" },
    "risk": { "enum": ["low", "medium", "high"] },
    "notes": { "type": "string" }
  }
}
