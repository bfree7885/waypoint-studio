# Names only. Never put live or test secret values in git.
# Copy to .dev.vars (Wrangler) or export in the local shell.

# test | mock — Phase 2 refuses live / sk_live
STRIPE_MODE=test

# Stripe TEST secret key (sk_test_...). Never sk_live.
STRIPE_SECRET_KEY=

# Stripe TEST webhook signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Stripe TEST Price id for Waypoint Ambient $4.99 USD / month.
STRIPE_PRICE_ID=

# Pepper for hashing magic-link and session tokens. Long random string.
SESSION_SECRET=

# Resend API key for magic-link email. Leave empty to capture links in mock/dev.
RESEND_API_KEY=

# From address that Resend is allowed to send.
EMAIL_FROM=Waypoint Ambient <ambient@waypointstudio.org>

# Comma-separated browser origins allowed to call the API with credentials.
ALLOWED_ORIGINS=https://waypointstudio.org,https://www.waypointstudio.org

# Frontend origin used in magic-link redirects and Checkout success/cancel URLs.
PUBLIC_APP_ORIGIN=https://waypointstudio.org

# This API's public origin (cookie + consume links).
ACCOUNTS_ORIGIN=https://accounts.waypointstudio.org

# Set 0 only for local HTTP. Production must be 1.
COOKIE_SECURE=1
