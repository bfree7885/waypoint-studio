      }
    },
    {
      "kind": "burst-poster",
      "x": 1348,
      "y": 348,
      "inspect": {
        "id": "story-poster",
        "title": "Event poster",
        "text": "A field-office print: DISTANT OUTBURST — HAPPENING NOW. The caption treats a far plate as tonight's news."
      }
    },
    {
      "kind": "cairn",
      "x": 380,
      "y": 440,
      "inspect": {
        "id": "story-west",
        "title": "West Rim Stake",
        "text": "A cairn and a painted baseline mark. The matching post is on the east rim. Walking this line is the measurement."
      }
    },
    {
      "kind": "survey-stake",
      "x": 2140,
      "y": 400,
      "inspect": {
        "id": "story-east",
        "title": "East Rim Stake",
        "text": "The other end of the baseline. Season plates from here should reverse a nearby shift, not a jump in the star."
      }
    },
    {
      "kind": "basin-rock",
      "x": 1220,
      "y": 1020,
      "inspect": {
        "id": "story-rock",
        "title": "Basin floor rock",
        "text": "A pale silicate you can pick up. Ordinary stone, sitting on the quiet pan, with a history that did not start in this hollow."
      }
    },
    {
      "kind": "horn",
      "x": 1360,
      "y": 940,
      "inspect": {
        "id": "story-horn",
        "title": "Quiet Floor horn",
        "text": "A coarse radio horn. Point it. The station wall is noisy. Overhead is quieter. That difference is evidence, not a slogan."
      }
    },
    {
      "kind": "glow-notch",
      "x": 280,
      "y": 720,
      "inspect": {
        "id": "story-glow",
        "title": "Glow Notch",
        "text": "A dip in the west rim. Faint town glow leaks here. This is why the work happens in the basin, not on the notch."
      }
    },
